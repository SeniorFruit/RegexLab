<Window x:Class="RegexLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegexLab"
        mc:Ignorable="d"
        Title="RegexLab — проверка регулярных выражений"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="48"
                    Height="48"
                    CornerRadius="14"
                    Background="{StaticResource AccentBrush}">
                <TextBlock Text=".*"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="RegexLab"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Проверка выражений и поиск совпадений в тексте"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="1,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Рабочая область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- Ввод -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <TextBlock Text="Регулярное выражение"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="обязательно"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>

                    <TextBox x:Name="ExpressionInput"
                             Grid.Row="1"
                             Height="76"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Disabled"
                             Style="{StaticResource InputTextBoxStyle}" />

                    <Grid Grid.Row="2" Margin="0,18,0,7">
                        <TextBlock Text="Строка для проверки"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="TextLengthLabel"
                                   Text="0 символов"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>

                    <TextBox x:Name="TestInput"
                             Grid.Row="3"
                             MinHeight="170"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource InputTextBoxStyle}"
                             TextChanged="TestInput_TextChanged" />

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <CheckBox x:Name="IgnoreCaseCheckBox"
                                  Content="Игнорировать регистр"
                                  Style="{StaticResource OptionCheckBoxStyle}"
                                  VerticalAlignment="Center" />
                        <Button x:Name="ExampleButton"
                                Content="Пример"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ExampleButton_Click" />
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ClearButton"
                                Content="Очистить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearButton_Click" />

                        <TextBlock Grid.Column="1"
                                   Text="Ctrl + Enter"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   Style="{StaticResource HintTextStyle}" />

                        <Button x:Name="AnalyzeButton"
                                Grid.Column="2"
                                Content="Проверить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AnalyzeButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Результат -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Результат"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="MatchesHeader"
                                   Text="ожидание проверки"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>

                    <Border x:Name="StatusBanner"
                            Grid.Row="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="StatusIconCircle"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="{StaticResource SurfaceBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="StatusIcon"
                                           Text="•"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="StatusTitle"
                                           Text="Готово к проверке"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="StatusMessage"
                                           Text="Введите выражение и строку, затем нажмите «Проверить»."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Текст с подсветкой"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,7" />

                    <Border Grid.Row="3"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            MinHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="HighlightedText"
                                       Text="Здесь появится текст с выделенными совпадениями."
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13.5"
                                       LineHeight="22"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Expander Grid.Row="4"
                              Margin="0,16,0,0"
                              FontSize="12.5"
                              Foreground="{StaticResource TextSecondaryBrush}">
                        <Expander.Header>
                            <TextBlock Text="Поддерживаемый синтаксис"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Expander.Header>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   LineHeight="20"
                                   Margin="0,8,0,0">
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">.</Run><Run> — любой символ, кроме перевода строки</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">\d \w \s</Run><Run> — цифра, буква/цифра/_, пробельный символ</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">[abc] [^abc] [a-z]</Run><Run> — наборы и диапазоны</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">* + ? {n} {n,} {n,m}</Run><Run> — квантификаторы</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">(...) (?:...) |</Run><Run> — группы и альтернатива</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">^ $ \b \B</Run><Run> — якоря и границы слова</Run><LineBreak />
                            <Run FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource AccentBrush}">\n \t \\ \.</Run><Run> — escape-последовательности</Run><LineBreak />
                            <Run FontStyle="Italic">Обратные ссылки, lookaround и \p{...} не поддерживаются.</Run>
                        </TextBlock>
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <!-- Подвал -->
        <Grid Grid.Row="2" Margin="2,16,2,0">
            <TextBlock Text="RegexLab · Лабораторная работа №2"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Grid>
    </Grid>
</Window>
